# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive vars
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include example tfvars if you want a template, but usually .tfvars are ignored
# !example.tfvars

# Ignore CLI configuration files
.terraformrc
terraform.rc
